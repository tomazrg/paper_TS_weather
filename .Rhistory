impact_p90_p10 <- function(curves_by_year){
purrr::imap_dfr(curves_by_year, function(x, yr){
q10 <- quantile(x$grid, .10, na.rm=TRUE)
q90 <- quantile(x$grid, .975, na.rm=TRUE)
# aproxima RR por pontos mais próximos do grid
idx10 <- which.min(abs(x$grid - q10))
idx90 <- which.min(abs(x$grid - q90))
tibble::tibble(
year = as.integer(yr),
RRv_delta = x$RR_vertical[idx90],
RRh_delta = x$RR_horizontal[idx90] ,
RR_v_perc = (RRv_delta-1)*100,
RR_h_perc = (RRh_delta-1)*100
)
})
}
curves_by_year_tmean <- rr_by_year_list(
var = "tmean",
cb = cb_templates[["tmean"]],
fit = fit_tmb,
wx_use = wx_use,
dat = dat
)
curves_by_year_rain <- rr_by_year_list(
var = "rain",
cb = cb_templates[["rain"]],
fit = fit_tmb,
wx_use = wx_use,
dat = dat
)
curves_by_year_vpd <- rr_by_year_list(
var = "vpd",
cb = cb_templates[["vpd"]],
fit = fit_tmb,
wx_use = wx_use,
dat = dat
)
tmean_p90_10 = impact_p90_p10(curves_by_year_tmean)
rain_p90_10 = impact_p90_p10(curves_by_year_rain)
vpd_p90_10 = impact_p90_p10(curves_by_year_vpd)
######### TMEAN
tmean_long <- tmean_p90_10 %>%
pivot_longer(
cols = c(RRh_delta, RRv_delta),
names_to = "phase",
values_to = "RR_delta"
) %>%
mutate(
phase = recode(phase,
RRh_delta = "Earlier",
RRv_delta = "Later")
)
df <- tmean_long %>%
mutate(Effect = ifelse(RR_delta >= 1, "Positive", "Negative"))
tmean_year_plot = df %>%
ggplot(aes(x = as.factor(year), y = RR_delta)) +
# linha horizontal de referência
geom_hline(yintercept = 1, linetype = "dashed", color = "grey40") +
# Earlier (nudge left) — segmento com linetype
geom_segment(
data = df %>% filter(phase == "Earlier"),
aes(xend = as.factor(year), yend = 1, color = Effect, linetype = phase),
linewidth = 0.8,
position = position_nudge(x = -0.15)
) +
geom_point(
data = df %>% filter(phase == "Earlier"),
aes(color = Effect),
size = 2.5,
position = position_nudge(x = -0.15)
) +
# Later (nudge right) — segmento com linetype
geom_segment(
data = df %>% filter(phase == "Later"),
aes(xend = as.factor(year), yend = 1, color = Effect, linetype = phase),
linewidth = 0.8,
position = position_nudge(x = 0.15)
) +
geom_point(
data = df %>% filter(phase == "Later"),
aes(color = Effect),
size = 2.5,
position = position_nudge(x = 0.15)
) +
# cores (acima/abaixo de 1)
scale_color_manual(values = c("Positive" = "red", "Negative" = "darkgreen")) +
# linetype por phase
scale_linetype_manual(values = c("Earlier" = "solid", "Later" = "dashed")) +
labs(x = "", y = expression(RR[delta])) +
theme_bw() +
theme(legend.position = "none",
axis.text.x = element_blank())
######### RAIN
rain_long <- rain_p90_10 %>%
pivot_longer(
cols = c(RRh_delta, RRv_delta),
