rain = seq(5, 600,length.out = 500)
vpd = c(0.66,1,1.5)
combined_data<- expand.grid(tmax = tmax, rain = rain, vpd = vpd)
library(purrr)
combined_data$sev <- apply(
combined_data[, c("tmax", "rain", "vpd")],
1,
function(x) {
predict_scenario(
fit = fit_sel,
dat = dat,
wx_long = wx_use,
cb_templates = cb_templates,
tmax_val = x[1],
rain_val = x[2],
vpd_val  = x[3],
pop_level = TRUE
)
}
)
combined_data
gc()
