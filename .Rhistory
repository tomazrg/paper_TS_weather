# Constrói crossbasis de uma série sintética usando os mesmos argumentos de 'cb_ref'
build_cb_like <- function(series, cb_ref) {
dlnm::crossbasis(series,
argvar = attr(cb_ref, "argvar"),
arglag = attr(cb_ref, "arglag"))
}
# Gera uma linha de newdata com o ÚLTIMO dia como a avaliação (R6)
# Cada cenário define valores CONSTANTES ao longo dos lags (pode adaptar para cenários por fase)
newdata_from_scenario <- function(t_val, r_val, v_val, cb_t, cb_r, cb_v, base_row = dat[1, ]) {
# série constante
t_series <- rep(t_val, attr(cb_t, "lag")$lag + 1)
r_series <- rep(r_val, attr(cb_r, "lag")$lag + 1)
v_series <- rep(v_val, attr(cb_v, "lag")$lag + 1)
cbt <- build_cb_like(t_series, cb_t)
cbr <- build_cb_like(r_series, cb_r)
cbv <- build_cb_like(v_series, cb_v)
# pega a ÚLTIMA linha (evento/avaliação)
Xt <- as.data.frame(cbt[nrow(cbt), , drop=FALSE])
Xr <- as.data.frame(cbr[nrow(cbr), , drop=FALSE])
Xv <- as.data.frame(cbv[nrow(cbv), , drop=FALSE])
# monta uma linha de dados com as MESMAS colunas usadas no ajuste
out <- base_row
# substitui colunas das bases (precisa que nomes batam os do ajuste!)
for (nm in colnames(Xt)) out[[nm]] <- Xt[[nm]]
for (nm in colnames(Xr)) out[[nm]] <- Xr[[nm]]
for (nm in colnames(Xv)) out[[nm]] <- Xv[[nm]]
# garanta outras covariáveis fixas iguais ao centro/medianas de 'dat' se existirem
out
}
predict_severity_scenarios <- function(fit, cb_t, cb_r, cb_v,
t_vals, r_vals, v_vals,
base_row = dat[1, ]) {
grid <- expand_grid(t = t_vals, r = r_vals, v = v_vals)
preds <- pmap(grid, function(t, r, v) {
nd <- newdata_from_scenario(t, r, v, cb_t, cb_r, cb_v, base_row)
mu <- predict(fit, newdata = nd, type = "response", re.form = NA)
eta <- predict(fit, newdata = nd, type = "link",     re.form = NA)
tibble(tmean = t, rain = r, vpd = v,
severity = as.numeric(mu),
eta = as.numeric(eta))
}) %>% bind_rows()
preds
}
