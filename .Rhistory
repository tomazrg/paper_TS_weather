library(dlnm)
library(glmmTMB)
library(ggplot2)
library(dplyr)
library(tidyr)
library(purrr)
library(stringr)
library(mvtnorm)
# ===== Ajuste esperado já existente =====
# fit_tmb   -> seu modelo glmmTMB(beta_family(link="logit"))
# dat       -> seu data.frame com uma linha por avaliação (p.ex., R6)
# cb_tmean, cb_rain, cb_vpd -> matrizes cross-basis usadas no ajuste
# lag_max   -> p.ex., 70
# ===== Utilitários genéricos =====
get_coef_vcov <- function(cb, fit) {
# Seleciona coeficientes do modelo que correspondem às colunas do cross-basis
nm <- colnames(cb)
b  <- coef(fit)$cond
# b é uma lista por parâmetro? Para modelos simples com beta/logit, use:
b_vec <- unlist(b)
idx   <- which(names(b_vec) %in% nm)
if (length(idx) != ncol(cb)) {
stop("coef/vcov não batem com o cross-basis. Verifique nomes das colunas no modelo.")
}
vc    <- vcov(fit)$cond
list(coef = b_vec[idx], vcov = vc[idx, idx, drop=FALSE])
}
