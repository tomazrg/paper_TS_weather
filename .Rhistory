safe_get_era5 <- function(x) {
for (i in 1:5) {
res <- try(
get_era5(
data        = x,
days_around = 85,
date_col    = "allowed_date",
study_col   = "id1",
pars        = c(
"temperature_2m",
"relative_humidity_2m",
"precipitation",
"dewpoint_2m"
),
direction   = "forth"
),
silent = TRUE
)
if (!inherits(res, "try-error")) return(res)
Sys.sleep(60)   # espera 1 minuto antes de tentar de novo
}
return(NULL)
}
wx_states <- map_dfr(chunks, safe_get_era5)
