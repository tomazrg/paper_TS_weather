window_effect <- function(cb, fit, from, to, at_seq, cen_value) {
kv <- get_coef_vcov(cb, fit)
cp <- cp_wrap(cb, kv$coef, kv$vcov, at = at_seq, cen = cen_value)
cr <- crossreduce(cp, from = from, to = to)  # efeito acumulado na janela
tibble(at = at_seq,
fit = cr$allfit,
lcl = cr$alllow,
ucl = cr$allhigh,
from = from, to = to)
}
