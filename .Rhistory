# ==== CENÁRIOS DLNM EM UM ÚNICO CHUNK (TMEAN, RAIN, VPD) =====================
# Pacotes
suppressPackageStartupMessages({
library(dlnm); library(glmmTMB); library(ggplot2)
library(dplyr); library(tidyr); library(purrr)
})
# --------------------------- 1) HELPERS ROBUSTOS ------------------------------
# Constrói crossbasis sintético com MESMOS nomes do utilizado no ajuste
build_cb_like <- function(series, cb_ref) {
cb_new <- dlnm::crossbasis(series,
argvar = attr(cb_ref, "argvar"),
arglag = attr(cb_ref, "arglag"))
colnames(cb_new) <- colnames(cb_ref)  # garante consistência de nomes
cb_new
}
# Gera uma linha de newdata a partir de um cenário (último dia = avaliação)
newdata_from_scenario <- function(t_val, r_val, v_val,
cb_t, cb_r, cb_v,
base_row = dat[1, ]) {
# comprimentos coerentes com lag_max de cada base
Lt <- attr(cb_t, "arglag")$lag;  Lr <- attr(cb_r, "arglag")$lag;  Lv <- attr(cb_v, "arglag")$lag
t_series <- rep(t_val, Lt + 1)
r_series <- rep(r_val, Lr + 1)
v_series <- rep(v_val, Lv + 1)
cbt <- build_cb_like(t_series, cb_t)
cbr <- build_cb_like(r_series, cb_r)
cbv <- build_cb_like(v_series, cb_v)
Xt <- as.data.frame(cbt[nrow(cbt), , drop = FALSE])
Xr <- as.data.frame(cbr[nrow(cbr), , drop = FALSE])
Xv <- as.data.frame(cbv[nrow(cbv), , drop = FALSE])
nd <- base_row
for (nm in colnames(Xt)) nd[[nm]] <- Xt[[nm]]
for (nm in colnames(Xr)) nd[[nm]] <- Xr[[nm]]
for (nm in colnames(Xv)) nd[[nm]] <- Xv[[nm]]
nd
}
# Predições para grade de cenários (severidade em %; OR=eta para diagnóstico)
predict_severity_scenarios <- function(fit, cb_t, cb_r, cb_v,
t_vals, r_vals, v_vals,
base_row = dat[1, ]) {
grid <- expand_grid(t = t_vals, r = r_vals, v = v_vals)
preds <- pmap(grid, function(t, r, v) {
nd  <- newdata_from_scenario(t, r, v, cb_t, cb_r, cb_v, base_row)
mu  <- predict(fit, newdata = nd, type = "response", re.form = NA)
eta <- predict(fit, newdata = nd, type = "link",     re.form = NA)
tibble(tmean = t, rain = r, vpd = v,
severity = as.numeric(mu), eta = as.numeric(eta))
}) %>% bind_rows()
preds
}
