library(gsheet)
points = read_xlsx("data/points_states.xlsx")
years <- 2012:2024
p_states <- crossing(points, year = years)
p_states <- p_states %>%
mutate(
# Criando a data permitida diretamente com base no estado
allowed_date = case_when(
state == "MT" ~ as.Date(paste0(format(year), "-09-16")),
state == "MS" ~ as.Date(paste0(format(year), "-09-16")),
state == "GO" ~ as.Date(paste0(format(year), "-09-25")),
state == "PR" ~ as.Date(paste0(format(year), "-09-11")),
state == "TO" ~ as.Date(paste0(format(year), "-10-01")),
state == "DF" ~ as.Date(paste0(format(year), "-10-01")),
state == "BA" ~ as.Date(paste0(format(year), "-10-01")),
state == "MG" ~ as.Date(paste0(format(year), "-10-01")) ,
state == "SP" ~ as.Date(paste0(format(year), "-10-01"))
))
p_states$id1 <- seq_len(nrow(p_states))
p_states <- p_states %>%
mutate(
id1 = as.integer(id1),
allowed_date = as.Date(allowed_date)
)
p_states = p_states %>%
mutate(
PD85 = allowed_date+85
)
p_states
# =========================================================
# 0) Pacotes
# =========================================================
library(terra)
library(dplyr)
library(tidyr)
library(lubridate)
# =========================================================
# 1) ENTRADA: NetCDF diário (2012 inteiro)
# =========================================================
nc_path <- "C:/Users/RTomaz/OneDrive - LSU AgCenter/Documents/GitHub/paper_TS_weather/data/era5land_daily_tmax_2012_2025.nc"
# =========================================================
# 2) LER O NetCDF
# =========================================================
r <- rast(nc_path)
dates_all <- as.Date(time(r))
if (all(is.na(dates_all))) {
stop("Datas não encontradas no NetCDF.")
}
# =========================================================
# 3) PREPARAR p_states
# =========================================================
p_states <- p_states %>%
mutate(
allowed_date = as.Date(allowed_date),
PD85         = as.Date(PD85),
pt_id        = row_number()
)
pts_v <- vect(
p_states,
geom = c("longitude", "latitude"),
crs  = "EPSG:4326"
)
# =========================================================
# 4) GARANTIR CRS CONSISTENTE
# =========================================================
if (!is.na(crs(r)) && crs(r) != crs(pts_v)) {
pts_v <- project(pts_v, crs(r))
}
# =========================================================
# 5) EXTRAÇÃO (COM lon/lat!)
# =========================================================
ext <- terra::extract(
r,
pts_v,
xy = TRUE,     # <<< ESSENCIAL
ID = FALSE
)
pts_v
r
# =========================================================
# 5) EXTRAÇÃO (COM lon/lat!)
# =========================================================
ext <- terra::extract(
r,
pts_v,
xy = TRUE,     # <<< ESSENCIAL
ID = FALSE
)
wx_use
mu_ref
