# Converte objeto crosspred em tibble longo
tidy_cp_overall <- function(cp, varname) {
tibble(!!varname := cp$predvar,
fit  = cp$allfit,
lcl  = cp$alllow,
ucl  = cp$allhigh)
}
# RR% helper (opcional). Atenção: em beta-logit o exp(eta) dá OR, não RR.
# Use apenas como "percentual relativo" do efeito no preditor linear acumulado.
perc_change <- function(x) (x - 1) * 100
lag_contribution <- function(cb, fit, at_value, cen_value, var_label) {
kv <- get_coef_vcov(cb, fit)
cp <- cp_wrap(cb, kv$coef, kv$vcov, at = c(cen_value, at_value), cen = cen_value)
# cp$matfit: matriz [exposure x lag]. Pega linha do contraste (at_value) - linha do centro (cen)
# Como já centralizamos em 'cen', a linha de referência é ~0; usamos a do 'at_value'.
M   <- cp$matfit[which(cp$predvar == at_value), , drop=TRUE]
SE  <- cp$matse[ which(cp$predvar == at_value), , drop=TRUE]
tibble(lag = as.numeric(colnames(cp$matfit)),
effect = M,
se = SE,
var = var_label)
}
# EXEMPLO DE USO:
contr_t <- lag_contribution(cb_tmean, fit_tmb, at_value = quantile(dat$tmean,.90), cen_value = P50_t, var_label="TMEAN")
cb_tmean
critical_window <- function(cb, fit, at_value, cen_value, min_len = 7) {
contr <- lag_contribution(cb, fit, at_value, cen_value, var_label = "var")
x <- abs(contr$effect)
n <- length(x)
# Busca exaustiva simples de janelas [i, j] com j-i+1 >= min_len
best <- list(score = -Inf, from = NA, to = NA)
for (i in 1:(n-min_len+1)) {
for (j in (i+min_len-1):n) {
s <- sum(x[i:j], na.rm=TRUE)
if (s > best$score) best <- list(score = s, from = contr$lag[i], to = contr$lag[j])
}
}
best
}
