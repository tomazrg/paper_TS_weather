br <- read_country(year = 2020)
library(sf)
library(dplyr)
bb_br <- st_bbox(br)
bb_br <- st_bbox(br)
grid_br <- st_make_grid(
st_as_sfc(bb_br),
cellsize = 0.10,
what = "centers"
) %>%
st_as_sf(crs = 4326) %>%
st_intersection(br) %>%   # mantém só pixels dentro do Brasil
mutate(
longitude = st_coordinates(.)[,1],
latitude  = st_coordinates(.)[,2]
)
