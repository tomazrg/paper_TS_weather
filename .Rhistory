gain_res = big_one_df %>%
filter(lambda == 0.65) %>%
mutate(class = case_when(sn_res > 0.30 ~ "High severity",
sn_res <= 0.30 ~"Low severity")) %>%
mutate(class2 = case_when(b0_res > median(b0_res) ~ "High yield",
b0_res <= median(b0_res) ~ "Low yield")) %>%
filter(C <= 105) %>%
select(income_res,class,class2)
gain_res$scenario = "High tolerance"
colnames(gain_res) = c("income","class","class2","scenario")
gain_m = big_one_df %>%
filter(lambda == 0.65) %>%
mutate(class = case_when(sn_m_sus > 0.30 ~ "High severity",
sn_m_sus <= 0.30 ~"Low severity")) %>%
mutate(class2 = case_when(b0_m_sus > median(b0_m_sus) ~ "High yield",
b0_m_sus <= median(b0_m_sus) ~ "Low yield")) %>%
filter(C <= 105) %>%
select(income_m_sus,class,class2)
gain_m$scenario = "Medium tolerance"
colnames(gain_m) = c("income","class","class2","scenario")
gain_s = big_one_df %>%
filter(lambda == 0.65) %>%
mutate(class = case_when(sn_sus > 0.30 ~ "High severity",
sn_sus <= 0.30 ~"Low severity")) %>%
mutate(class2 = case_when(b0_sus > median(b0_sus) ~ "High yield",
b0_sus <= median(b0_sus) ~ "Low yield")) %>%
filter(C <= 105) %>%
select(income_sus,class,class2)
gain_s$scenario = "Low tolerance"
colnames(gain_s) = c("income","class","class2","scenario")
gain_all = rbind(gain_res,gain_m,gain_s)
library(ggdist)
gain_all %>%
ggplot(aes(income, fill = class)) +
#geom_histogram(color  = "white",fill = "black")+
stat_halfeye(alpha = 0.9)+ #ffc425
facet_wrap(~ scenario)+
#scale_fill_viridis_d(option = "G")+
scale_fill_manual(values=c("#009628","darkred"))+
xlim(0,1500)+
scale_x_continuous(expand = c(0, 0),
limits = c(0,1500),
breaks = seq(0, 1500, by = 500)) +
ggthemes::theme_few()+
labs(
y = "Density",
x = "Economic return (USD/ha)",
fill = "Disease pressure")+
