library(MASS)
library(dplyr)
library(ggplot2)
# --------------------------
# 1) Simular coeficientes
# --------------------------
set.seed(123)
nsim <- 1000   # número de simulações
beta_sim <- mvrnorm(n = nsim, mu = beta, Sigma = vc_sub)
# --------------------------
# 2) Função para calcular RR acumulado
# --------------------------
compute_rr <- function(beta_vec){
cp_sim <- crosspred(
cb,
coef = beta_vec,
vcov = vc_sub,   # pode manter vc_sub
at   = grid,
cen  = P50,
bylag = 1
)
mf_sim <- cp_sim$matfit
etaA_sim <- apply(mf_sim[, colsA, drop=FALSE], 1, sum)
exp(etaA_sim)
}
# --------------------------
# 3) Calcular RR para cada simulação
# --------------------------
RR_sim_list <- lapply(1:nsim, function(i) {
compute_rr(beta_sim[i, ])
})
var <- "rain"
cb  <- cb_templates[[var]]
cf  <- coef(summary(fit_tmb))$cond[,1]
vc  <- vcov(fit_tmb)$cond
prefix <- paste0("cb_", var, "_")
idx <- grepl(prefix, names(cf))
beta   <- cf[idx]
vc_sub <- vc[idx, idx]
# valores para curva completa
x_all   <- wx_use[[var]]
grid    <- sort(unique(as.numeric(quantile(x_all, seq(0.05,0.95,by=0.01)))))
# referência (P50) usada como centragem
P50 <- quantile(x_all, 0.50, na.rm=TRUE)
cp <- crosspred(
cb,
coef = beta,
vcov = vc_sub,
at   = grid,
cen  = P50,
bylag = 1
)
mf <- cp$matfit     # matriz: rows = grid, cols = lags
lag_idx <- suppressWarnings(as.integer(gsub("lag","", colnames(mf))))
if(anyNA(lag_idx)) lag_idx <- 0:(ncol(mf)-1)
colsA <- which(lag_idx %in% 60:70)
# efeito cumulativo para CADA temperatura do grid
etaA <- apply(mf[, colsA, drop=FALSE], 1, sum)
RR <- exp(etaA)
rr_sum <- data.frame(
tmean = grid,
RR_med = RR
)
rr_sum %>%
# filter(tmean >=25) %>%
filter(tmean >=5) %>%
#filter(tmean >=0.66) %>%
ggplot(aes(x=tmean, y=RR_med)) +
geom_hline(yintercept = 1, linetype=2) +
geom_smooth() +
labs(x="Precipitacao (mm)",
y="Razão de odds relativa (P75 vs P50, lags 60–70)",
title="Efeito cumulativo de precipitacao na janela 60–70 dias") +
theme_bw()
