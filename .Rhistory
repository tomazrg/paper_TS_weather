}
)
}
)
results[[k]] <- res_chunk
# pausa extra entre chunks para evitar 429
Sys.sleep(2)
}
bind_rows(results)
}
# --- executar com seus 254 pontos (ajuste chunk_size/pause conforme necessário) ---
PF_era5_2024_std <- process_in_chunks(ma2, chunk_size = 50, pause_sec = 0.25, tries = 6)
library(httr)
library(jsonlite)
library(dplyr)
library(lubridate)
start_date <- "2024-01-01"
end_date   <- "2024-12-31"
base_url   <- "https://archive-api.open-meteo.com/v1/era5"
# ⚠️ Se usar 'relative_humidity_2m_mean' o endpoint diário do Open-Meteo
# costuma retornar 400. Se mantiver, trate o erro com tryCatch.
daily_vars <- c("temperature_2m_max", "temperature_2m_min", "precipitation_sum")
# data.frame final acumulador
PF_era5_2024_std <- tibble()
for (i in seq_len(nrow(ma2))) {
lat_pf <- ma2$lat[i]
lon_pf <- ma2$longitude[i]
query_list <- list(
latitude   = lat_pf,
longitude  = lon_pf,
start_date = start_date,
end_date   = end_date,
daily      = paste(daily_vars, collapse = ","),
timezone   = "America/Sao_Paulo"
)
# pequena pausa para evitar 429
Sys.sleep(0.2)
# envolva em tryCatch para continuar mesmo com erro pontual
df_i <- tryCatch({
res <- httr::GET(base_url, query = query_list)
httr::stop_for_status(res)
dat_list <- jsonlite::fromJSON(httr::content(res, as = "text", encoding = "UTF-8"))
as.data.frame(dat_list$daily) |>
mutate(
DATE = as.Date(time),
lat  = lat_pf,
lon  = lon_pf
) |>
transmute(
source = "ERA5",
DATE, lat, lon,
T2MAX       = temperature_2m_max,
T2MIN       = temperature_2m_min,
PRECTOTCORR = precipitation_sum
# RH2M = relative_humidity_2m_mean # só se realmente existir
)
}, error = function(e) {
message("Falha para lat=", lat_pf, " lon=", lon_pf, " -> ", e$message)
# retorna vazio com colunas esperadas para não quebrar o bind_rows
tibble(
source = character(),
DATE   = as.Date(character()),
lat    = numeric(),
lon    = numeric(),
T2MAX  = numeric(),
T2MIN  = numeric(),
PRECTOTCORR = numeric()
# RH2M = numeric()
)
})
PF_era5_2024_std <- dplyr::bind_rows(PF_era5_2024_std, df_i)
}
library(httr)
library(jsonlite)
library(dplyr)
library(lubridate)
library(purrr)
start_date <- "2024-01-01"
end_date   <- "2024-12-31"
base_url   <- "https://archive-api.open-meteo.com/v1/era5"
timezone   <- "America/Sao_Paulo"
daily_vars <- c("temperature_2m_max", "temperature_2m_min", "precipitation_sum")
fetch_one_pf <- function(lat_pf, lon_pf) {
Sys.sleep(0.2) # pausa para evitar 429
query_list <- list(
latitude   = lat_pf,
longitude  = lon_pf,
start_date = start_date,
end_date   = end_date,
daily      = paste(daily_vars, collapse = ","),
timezone   = timezone
)
res <- httr::GET(base_url, query = query_list)
httr::stop_for_status(res)
dat_list <- jsonlite::fromJSON(httr::content(res, as = "text", encoding = "UTF-8"))
as.data.frame(dat_list$daily) |>
mutate(DATE = as.Date(time), lat = lat_pf, lon = lon_pf) |>
transmute(
source = "ERA5",
DATE, lat, lon,
T2MAX       = temperature_2m_max,
T2MIN       = temperature_2m_min,
PRECTOTCORR = precipitation_sum
)
}
PF_era5_2024_std <- purrr::map2_dfr(
ma2$lat,
ma2$longitude,
~ tryCatch(fetch_one_pf(.x, .y),
error = function(e) {
message("Falha para lat=", .x, " lon=", .y, " -> ", e$message)
tibble(
source = character(),
DATE   = as.Date(character()),
lat    = numeric(),
lon    = numeric(),
T2MAX  = numeric(),
T2MIN  = numeric(),
PRECTOTCORR = numeric()
)
})
) |>
