aes(color = Effect),
size = 2.5,
position = position_nudge(x = -0.15)
) +
# Later (nudge right) — segmento com linetype
geom_segment(
data = df %>% filter(phase == "Later"),
aes(xend = as.factor(year), yend = 1, color = Effect, linetype = phase),
linewidth = 0.8,
position = position_nudge(x = 0.15)
) +
geom_point(
data = df %>% filter(phase == "Later"),
aes(color = Effect),
size = 2.5,
position = position_nudge(x = 0.15)
) +
# cores (acima/abaixo de 1)
scale_color_manual(values = c("Positive" = "red", "Negative" = "darkgreen")) +
# linetype por phase
scale_linetype_manual(values = c("Earlier" = "solid", "Later" = "dashed")) +
labs(x = "Year", y = expression(RR[delta])) +
theme_bw() +
theme(legend.position = "right")
vpd_year_plot
(tmean_year_plot/rain_year_plot/vpd_year_plot)
